#!/bin/sh
# commit-msg hook -- enforces the commit-subject format (fw-T3.C1.S2 / fw-T3.C1.S7.SS2).
#
# Portable POSIX sh (NOT PowerShell) so it runs regardless of whether PowerShell is
# present -- the deterministic local gate from the USFLP01-FDS C4/C12 disposition.
# Installed by new-project.ps1 Phase 1 via:  git config core.hooksPath Workflows/hooks
# so it travels with the repo and fires from commit #1.
#
# Accepts EITHER:
#   1. the six-type conventional form  "<type>: <imperative subject, <=70 chars>"
#      with type in: feat | fix | refactor | docs | chore | baseline  (fw-T3.C1.S2.SS1)
#   2. the version-bump headline form  "<prefix>-vX.Y.Z {MAJOR|MINOR|PATCH}: ..."
#      (fw-T8.C1.S1.SS5; intentionally exempt from the 70-char cap -- the headline is
#      the canonical release name, per the Phase-AA no-cap rule), or a merge commit.
#
# Exit 0 = accept; exit 1 = reject (git aborts the commit).

msg_file="$1"
# Strip a trailing CR (fw-v0.28.0; USFLP01-FDS round-3): on Windows the message file
# is often CRLF, and a trailing CR would inflate the wc -c length count (false-reject a
# 70-char subject at 71) and can throw off pattern matches. Normalize to LF-only.
subject=$(head -n 1 "$msg_file" | tr -d '\r')

# Merge commits pass through.
case "$subject" in
  "Merge "*) exit 0 ;;
esac

# Version-bump headline form (no length cap).
if printf '%s' "$subject" | grep -Eq '^[a-z][a-z0-9-]*-v[0-9]+\.[0-9]+\.[0-9]+ (MAJOR|MINOR|PATCH)\b'; then
  exit 0
fi

# Conventional six-type form.
if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|refactor|docs|chore|baseline): .+'; then
  echo "commit-msg REJECTED (fw-T3.C1.S2): subject must be '<type>: <imperative>'" >&2
  echo "  with <type> in: feat | fix | refactor | docs | chore | baseline," >&2
  echo "  OR a version-bump headline '<prefix>-vX.Y.Z {MAJOR|MINOR|PATCH}: ...' (fw-T8.C1.S1.SS5)." >&2
  echo "  Got: $subject" >&2
  exit 1
fi

# <=70-char cap applies to the conventional form only.
len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 70 ]; then
  echo "commit-msg REJECTED (fw-T3.C1.S2.SS1): subject is $len chars; max 70 for the '<type>: ...' form." >&2
  echo "  Got: $subject" >&2
  exit 1
fi

exit 0
